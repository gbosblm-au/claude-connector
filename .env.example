# =============================================================================
# claude-connector  -  Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#
# For Claude Desktop: values can also be set in claude_desktop_config.json "env" block
# For Browser Claude:  values are set here or as environment variables on your cloud host
# See BROWSER-CLAUDE-SETUP.md for the browser Claude setup guide.
# =============================================================================


# -----------------------------------------------------------------------------
# HTTP SERVER (for browser-based Claude via claude.ai)
# -----------------------------------------------------------------------------

# Port for the HTTP server (default: 3000)
PORT=3000

# Host/bind address (0.0.0.0 = all interfaces, required for cloud deployments)
HOST=0.0.0.0

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Authentication key for the connector. As of v12.28.0 this is MANDATORY: the
# process refuses to bind its listener without it and exits non-zero.
#
# Until v12.28.0 this variable was documented here and declared in render.yaml
# but referenced nowhere in the code (TNX-C-001). The MCP transports /sse,
# /messages and /mcp read no credential at all, so anyone who could resolve the
# connector hostname obtained the entire tool surface: Google Drive read/write,
# Calendar, Sheets, WordPress publication, SMTP dispatch under the
# organisation's domain, LinkedIn, arbitrary Python execution via
# script_execute, and the persistent memory store.
#
# Minimum length 32 characters. Placeholder values are rejected at boot.
# Generate with:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Present it on every request as:  Authorization: Bearer <MCP_API_KEY>
# (or X-MCP-Api-Key: <MCP_API_KEY> for clients that cannot set Authorization).
MCP_API_KEY=

# Comma-separated list of browser origins permitted to make cross-origin
# requests. Leave BLANK for a server-to-server deployment; no CORS headers are
# then emitted at all, which blocks every cross-origin browser request.
#
# A literal "*" is REFUSED at boot. Reflecting arbitrary origins is the defect
# recorded as TNX-C-008; honouring the wildcard here would reintroduce it
# through configuration.
#   Example: MCP_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
MCP_ALLOWED_ORIGINS=

# Rate limiting on the MCP transports and /tool-call.
MCP_RATE_WINDOW_MS=60000
MCP_RATE_MAX=240

# Number of reverse-proxy hops in front of this service. Used to derive the
# real client IP for rate limiting. Do NOT set this higher than the actual
# number of trusted proxies: each extra hop is one more X-Forwarded-For entry a
# caller can forge to evade the limiter.
TRUST_PROXY_HOPS=1

# Request body limits. The small limit applies to every route; the large limit
# is applied only to the MCP transports, uploads, volume restores and the skill
# compiler. Previously 50mb applied globally to every endpoint.
MCP_BODY_LIMIT=2mb
MCP_LARGE_BODY_LIMIT=50mb

# API key to protect the CSV upload endpoint (POST /upload/connections).
# Required if you want to push your LinkedIn CSV to a remote cloud server.
# Leave blank to disable the upload endpoint entirely.
UPLOAD_API_KEY=


# -----------------------------------------------------------------------------
# WEB SEARCH PROVIDER
# -----------------------------------------------------------------------------
# Choose "brave" (default) or "tavily"
# Brave: https://brave.com/search/api/  (free tier: 2,000 queries/month)
# Tavily: https://tavily.com            (free tier: 1,000 searches/month)
SEARCH_PROVIDER=brave


# -----------------------------------------------------------------------------
# BRAVE SEARCH API KEY
# Required when SEARCH_PROVIDER=brave OR NEWS_PROVIDER=brave
# Get your key at: https://brave.com/search/api/
# -----------------------------------------------------------------------------
BRAVE_API_KEY=your_brave_api_key_here


# -----------------------------------------------------------------------------
# TAVILY API KEY
# Required when SEARCH_PROVIDER=tavily
# Get your key at: https://app.tavily.com
# -----------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here


# -----------------------------------------------------------------------------
# SERPER SEARCH API KEY (optional - used as automatic fallback when Brave fails)
# When SERPER_API_KEY is set and SEARCH_PROVIDER=brave, any Brave web or news
# search failure will automatically retry via Serper (Google Search).
# Free tier: 2,500 queries/month. Get your key at: https://serper.dev
# Leave blank to disable the Serper fallback entirely.
# -----------------------------------------------------------------------------
SERPER_API_KEY=


# -----------------------------------------------------------------------------
# NEWS PROVIDER
# -----------------------------------------------------------------------------
# Choose "brave" (default, reuses BRAVE_API_KEY) or "newsapi"
# NewsAPI: https://newsapi.org  (free tier: 100 requests/day, articles up to 1 month old)
NEWS_PROVIDER=brave


# -----------------------------------------------------------------------------
# NEWS API KEY
# Required when NEWS_PROVIDER=newsapi
# Get your key at: https://newsapi.org/register
# -----------------------------------------------------------------------------
NEWS_API_KEY=your_news_api_key_here


# -----------------------------------------------------------------------------
# IMAGE SEARCH PROVIDERS
# -----------------------------------------------------------------------------
# IMAGE_PROVIDER controls which provider is used by the image_search tool.
# Options: "pexels" | "unsplash" | "both" | "auto"
# "auto" (default): uses Pexels if PEXELS_API_KEY is set, else Unsplash.
# "both": queries both providers and interleaves results.
IMAGE_PROVIDER=auto

# Pexels API Key
# Required when IMAGE_PROVIDER=pexels or IMAGE_PROVIDER=auto (with Pexels preferred)
# Get a free key at: https://www.pexels.com/api/
# On Railway: set PEXELS_API_KEY in your service Variables tab
PEXELS_API_KEY=your_pexels_api_key_here

# Unsplash Access Key
# Required when IMAGE_PROVIDER=unsplash or IMAGE_PROVIDER=auto (as fallback)
# Get a free key at: https://unsplash.com/developers
# Note: Use the "Access Key" value (not the Secret Key) here.
# On Railway: set UNSPLASH_ACCESS_KEY in your service Variables tab
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here


# -----------------------------------------------------------------------------
# WORDPRESS (optional - for publishing to WordPress)
# -----------------------------------------------------------------------------
# Set these in Railway Variables tab or here for local development.
# WP_URL:          your WordPress site URL, e.g. https://yoursite.com (no trailing slash)
# WP_USERNAME:     your WordPress login username
# WP_APP_PASSWORD: Application Password from WP Admin > Users > Profile
#
# Alternatively, use the set_wordpress_credentials MCP tool from within Claude.
WP_URL=
WP_USERNAME=
WP_APP_PASSWORD=


# -----------------------------------------------------------------------------
# LINKEDIN PATHS
# -----------------------------------------------------------------------------
# Absolute path to your LinkedIn Connections.csv export
# Default: ./data/connections.csv (relative to this project)
# LINKEDIN_CSV_PATH=/absolute/path/to/your/Connections.csv

# Absolute path to your LinkedIn profile JSON (optional)
# Default: ./data/profile.json (relative to this project)
# LINKEDIN_PROFILE_PATH=/absolute/path/to/your/profile.json


# -----------------------------------------------------------------------------
# RESULT LIMITS
# -----------------------------------------------------------------------------
DEFAULT_WEB_RESULTS=10
DEFAULT_NEWS_RESULTS=10
MAX_WEB_RESULTS=20
MAX_NEWS_RESULTS=20

# Image result limits
DEFAULT_IMAGE_RESULTS=5
MAX_IMAGE_RESULTS=20


# -----------------------------------------------------------------------------
# IMAGE DOWNLOAD (for saving images locally)
# -----------------------------------------------------------------------------
# Directory where downloaded images are stored.
# Default: ./data/images (relative to the project root)
# For Docker/Railway, consider mounting a persistent volume.
IMAGE_DOWNLOAD_DIR=


# -----------------------------------------------------------------------------
# GOOGLE DRIVE (optional - for uploading images to Google Drive)
# -----------------------------------------------------------------------------
# Choose ONE authentication method:
#
# Option A - Service Account (recommended for server deployments):
#   1. Go to Google Cloud Console > IAM & Admin > Service Accounts
#   2. Create a service account, download the JSON key file
#   3. Enable the Google Drive API for your project
#   4. Share your target Google Drive folder with the service account email
#      (the email looks like: name@project-id.iam.gserviceaccount.com)
#   5. Set the path to the JSON key file below.
#
#      v12.28.0 (TNX-C-002): the previous auto-load fallback, which picked up
#      ./data/google-service-account.json when this variable was blank, has
#      been REMOVED, and the bundled key file has been deleted from the
#      repository. That fallback is why a live, unredacted RSA private key was
#      committed and copied into every Docker image.
#
#      Supply the key from a secrets manager or the platform's own secret
#      store and mount it at a path outside the build context. If this variable
#      is unset, Drive is simply not configured.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# Option B - OAuth2 Refresh Token (for personal Google accounts):
#   1. Go to Google Cloud Console > APIs & Services > Credentials
#   2. Create an OAuth 2.0 Client ID (Desktop app type)
#   3. Use the OAuth Playground (https://developers.google.com/oauthplayground)
#      to authorize and get a refresh token for the Drive API scope
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Default Google Drive folder ID for uploads (optional).
# Find this in the URL: https://drive.google.com/drive/folders/{FOLDER_ID}
GOOGLE_DRIVE_FOLDER_ID=

# OAuth scopes requested when fetching an access token.
#
# TNX-C-002 resolution item 6: full /auth/drive should be justified per tool,
# not defaulted. If the deployment only reads and writes files this connector
# created, drive.file is sufficient and dramatically narrows the blast radius
# of a key compromise. Set it explicitly:
#   GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file
#
# Default: full Drive access (required for searching/reading/modifying
# files that were not created by this app itself). You may restrict to
# "https://www.googleapis.com/auth/drive.readonly" for read-only access,
# or "https://www.googleapis.com/auth/drive.file" to restrict to files
# this app created (legacy behaviour of the original connector).
# Multiple scopes can be space or comma separated.
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive

# Optional: only used with Service Account + Workspace Domain-Wide
# Delegation. Set to the email of a Workspace user to impersonate.
GOOGLE_IMPERSONATE_SUBJECT=


# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Log level: "debug" | "info" | "warn" | "error"
# All logs go to stderr (for stdio server) or stdout (for HTTP server).
LOG_LEVEL=info


# =============================================================================
# v8.0.0 ADDITIONS
# =============================================================================

# -----------------------------------------------------------------------------
# GOOGLE CALENDAR
# Required scope (add to GOOGLE_DRIVE_SCOPES, space-separated):
#   GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/calendar
# Default calendar is "primary" (the authenticated account's main calendar).
# -----------------------------------------------------------------------------
GOOGLE_CALENDAR_ID=primary

# -----------------------------------------------------------------------------
# GOOGLE SHEETS
# Required scope (add to GOOGLE_DRIVE_SCOPES, space-separated):
#   GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/spreadsheets
# The spreadsheet ID is the string between /d/ and /edit in the Sheets URL.
# Set this as the default for sheets_read_range, sheets_write_range, sheets_append_rows.
# -----------------------------------------------------------------------------
GOOGLE_SHEETS_ID=

# -----------------------------------------------------------------------------
# SLACK
# Bot OAuth Token from https://api.slack.com/apps
# Required Bot Token Scopes: chat:write, chat:write.public
# Optional for username/icon override: chat:write.customize
# Default channel is used by slack_send_message when no channel is specified.
# -----------------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=

# -----------------------------------------------------------------------------
# MICROSOFT TEAMS
# Incoming Webhook URL from Teams channel > ... > Connectors > Incoming Webhook
# For multiple channels, pass webhook_url as a parameter per call.
# -----------------------------------------------------------------------------
TEAMS_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# INBOUND WEBHOOK RECEIVER
# POST /webhook accepts JSON payloads from external services.
# WEBHOOK_SECRET:       X-Webhook-Secret header value required on each request.
#                       Leave blank to disable authentication (not recommended).
# WEBHOOK_QUEUE_SIZE:   Maximum events held in memory (default 200).
# WEBHOOK_PERSIST_PATH: Optional file path to persist the queue across restarts.
#                       Leave blank to use in-memory only.
# -----------------------------------------------------------------------------
WEBHOOK_SECRET=
WEBHOOK_QUEUE_SIZE=200
WEBHOOK_PERSIST_PATH=


# =============================================================================
# v10.0.0 ADDITION - Persistent Memory MCP
# =============================================================================
#
# When MEMORY_AUTH_TOKEN is set, the connector advertises six memory_* tools
# (memory_write, memory_read, memory_search, memory_delete, memory_list,
# memory_get_session_context) backed by a SQLite + FTS5 database stored on the
# Railway persistent volume at /data/memory.db. When the variable is unset,
# the memory subsystem is gracefully disabled and the rest of the connector
# continues to function unchanged.
#
# Generate the token with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('hex'))"
# The result is a 72-character hex string (36 bytes of entropy). Store it as a
# Railway environment variable. Never commit it to git.
# -----------------------------------------------------------------------------
MEMORY_AUTH_TOKEN=

# Optional: override the SQLite database path. Default is /data/memory.db,
# which lives on the Railway persistent volume mounted by railway.toml.
# MEMORY_DB_PATH=/data/memory.db

# Optional: TTL expiry worker cadence in milliseconds. Default 1 hour.
# TTL_WORKER_INTERVAL_MS=3600000


# =============================================================================
# v10.1.0 ADDITION - Ava Memory Sync (durable MySQL backup)
# =============================================================================
#
# When both AVA_MEMORY_WP_URL and AVA_MEMORY_WP_KEY are set, the connector
# advertises three tools: ava_memory_backup, ava_memory_restore, and
# ava_memory_sync_status.
#
# These tools let the Ava skill push its Railway SQLite memory store to a
# durable MySQL database on your WordPress host, and restore from it if
# Railway is ever reset or wiped.
#
# Setup steps:
#   1. Install the ts-ava-memory WordPress plugin on truesourceconsulting.com.au
#   2. Go to Settings > Ava Memory in WordPress admin
#   3. Generate and save a secret key
#   4. Copy the REST base URL shown on that page
#   5. Set the two variables below in Railway Variables
#
# AVA_MEMORY_WP_URL: The REST base URL, e.g.:
#   https://truesourceconsulting.com.au/wp-json/ava-memory/v1
#
# AVA_MEMORY_WP_KEY: The secret key set in Settings > Ava Memory in WordPress.
#   Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
AVA_MEMORY_WP_URL=
AVA_MEMORY_WP_KEY=

# ---------------------------------------------------------------------------
# v12.37.0 -- document download links and script environment injection
# ---------------------------------------------------------------------------

# Public base URL of this connector. Used to build the download and preview
# links returned by script_execute, and published by GET /internal/config/env.
# A trailing slash and a missing scheme are both tolerated and normalised.
# Falls back to https://$RAILWAY_PUBLIC_DOMAIN when unset.
CONNECTOR_URL=https://claude-connector-production.up.railway.app

# Token embedded in /download and /preview URLs. Required for script_execute to
# return usable download_links. Keep this distinct from RAILWAY_RESTORE_TOKEN:
# the restore token also authenticates /tool-call and every /restore-* route, so
# it must never appear in a URL that reaches a browser address bar.
DOCUMENT_DOWNLOAD_TOKEN=

# Directory served by GET /download/:filename. Defaults to /data/downloads.
# Scripts write finished documents here; script_execute detects what changed and
# returns links for it.
# DOWNLOADS_DIR=/data/downloads

# Which values GET /internal/config/env publishes. Filtered against a frozen
# in-code ceiling of CONNECTOR_URL, DOCUMENT_DOWNLOAD_TOKEN and DATABASE_URL, so
# naming anything else here has no effect.
#
# Default when unset: CONNECTOR_URL only. Publishing the other two is rarely
# needed, because the connector builds download links itself and grants
# DATABASE_URL to scripts server-side via SCRIPT_ENV_MANIFEST.
# INTERNAL_CONFIG_KEYS=CONNECTOR_URL

# Which names script_execute accepts in its custom_env argument.
# Default when unset: CONNECTOR_URL,DATABASE_URL
# DOCUMENT_DOWNLOAD_TOKEN is deliberately excluded: a script never needs it.
# Names that would hijack the interpreter or loader (PYTHONPATH, PYTHONSTARTUP,
# LD_PRELOAD, PATH, ...) are refused by src/utils/scriptEnv.js even if named here.
# SCRIPT_CUSTOM_ENV_KEYS=CONNECTOR_URL,DATABASE_URL

# PREFERRED route for giving a script a secret: a server-side grant, so the
# value never passes through a model context. Two places, both required.
# SCRIPT_GRANTABLE_ENV=DATABASE_URL
# SCRIPT_ENV_MANIFEST={"postgres_recall.py":["DATABASE_URL"]}

# ---------------------------------------------------------------------------
# TNX-FEAT-SIGNEDURLS (v12.38.0) -- per-file signed download links
# ---------------------------------------------------------------------------

# Master HMAC key for download link signatures.
# Leave unset and the connector generates a 64-char hex secret on first boot and
# persists it to /data/.url_secret. Setting it explicitly is strongly preferred:
# it survives volume loss, is shared correctly across replicas, and rotating it
# is a variable change rather than a file edit. Rotating invalidates every
# outstanding link, which is the only bulk-revoke mechanism available.
# SIGNED_URL_SECRET=

# Where the bootstrapped secret is persisted. Must be on the mounted volume, or
# every outstanding link breaks at the next deploy.
# SIGNED_URL_SECRET_PATH=/data/.url_secret

# Lifetime of a generated link, in seconds. Default 259200 (3 days).
# Zero, negative and non-numeric values fall back to the default. Capped at 30
# days so a milliseconds value pasted here cannot restore unlimited lifetime.
#
# CALIBRATION: this is one of three retention settings that are meant to match.
# A signed link is stored on a document row by the Gateway Service and served
# from the sidebar for that row's whole life, so if this is shorter than the row
# TTL every sidebar button dies while the countdown beside it still shows days
# remaining. Change all three together:
#   LINK_EXPIRY_SECONDS=259200   (here)          -- 3 days
#   DOWNLOADS_TTL_HOURS=72       (here, below)   -- 3 days
#   DOCUMENT_TTL_DAYS=3          (Gateway Service) -- 3 days
# LINK_EXPIRY_SECONDS=259200

# Feature gate. Set to false to revert to the previous global-token links during
# rollout. Legacy links never expire and one leak exposes every document, so
# this should be true in normal operation.
# ENABLE_SIGNED_LINKS=true

# ---------------------------------------------------------------------------
# Artefact retention (the /data/downloads reaper)
# ---------------------------------------------------------------------------

# How long a generated document survives on the volume, in hours.
# Default 72 (3 days), calibrated to match LINK_EXPIRY_SECONDS above and the
# Gateway Service's DOCUMENT_TTL_DAYS.
#
# Do NOT set this below LINK_EXPIRY_SECONDS. The reaper keys off file mtime and
# links are minted at file-creation time, so an equal setting means the file
# outlives its link by up to one sweep interval. That is the safe direction: a
# late user gets the intended "link expired" message rather than a 404 on a link
# that still looks valid. A lower value inverts that and produces the 404.
# DOWNLOADS_TTL_HOURS=72

# Comma-separated filenames under /data/downloads that the reaper must never
# delete, regardless of age. ava_brain_data.json is the Neural Core
# architecture scan, fetched on every render of that view; it lives in downloads
# for delivery reasons, not because it is a disposable artefact.
# DOWNLOADS_PROTECTED=ava_brain_data.json

# How often the retention sweeper runs, in milliseconds. Default 900000
# (15 minutes). This is the granularity of deletion, not the policy.
# UPLOAD_SWEEP_INTERVAL_MS=900000

# Whether /download and /preview still accept the global DOCUMENT_DOWNLOAD_TOKEN
# while signed links are enabled. Defaults to true so that enabling signed links
# does not break links already in chat history, bookmarks or the WordPress UI.
#
# IMPORTANT: while this is true the global blast radius is only half removed,
# because a leaked token still opens every file. Set it to false once existing
# links have aged out to complete the migration.
# ALLOW_LEGACY_DOWNLOAD_TOKEN=true
