      "requires": ["self-model-architecture"]
    },
    {
      "id": "nudge-dispatch",
      "path": "modules/self-model/nudge-dispatch.md",
      "always_load": false,
      "triggers": {
        "keywords": ["nudge", "dismiss", "snooze", "surface", "show"],
        "phrases": [
          "nudge dispatch",
          "show me",
          "snooze",
          "dismiss the nudge",
          "surface a nudge",
          "how to deliver"
