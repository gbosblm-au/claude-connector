        "regex": ["silence[- ]respect"],
        "subjects": ["initiative", "background-awareness"]
      },
      "adjacency": {
        "co_load": ["background-awareness", "nudge-dispatch"],
        "weak_co_load": []
      },
      "requires": ["background-awareness"]
    }
  ],
  "mandatory_for_triggers": {},
  "tag_web": {
    "self-model": ["self-model", "self_model_query", "module_activations", "tool_usage", "introspection"],
    "sustained-self": ["state vector", "session state", "cross-session", "curiosity", "continuity", "self_state_read", "self_state_write"],
    "initiative": ["nudge", "nudge_check", "nudge_analyze", "nudge_action", "pattern", "proactive", "background awareness", "silence"]
