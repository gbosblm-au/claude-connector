          "pattern analysis",
          "anything you noticed",
          "anything worth flagging",
          "what patterns",
          "session close analysis",
          "proactive suggestion"
        ],
        "regex": ["nudge", "pattern[- ]analy"],
        "subjects": ["initiative", "background-awareness"]
