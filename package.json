{
  "name": "claude-connector",
  "version": "13.17.0",
  "description": "MCP server for Claude with persistent memory, real-time web search, news search, LinkedIn connections lookup, TrueSource outreach email send/tracking/scheduling, Google Drive/Calendar/Sheets integration, Slack/Teams messaging, inbound webhooks, WordPress publishing, image search/download, psychology assessment, plus comprehensive statistical analysis and machine learning + multi-tenant client gateway support",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/server-http.js",
    "start:http": "node src/server-http.js",
    "start:stdio": "node src/index.js",
    "start:v8compat": "node src/index.js",
    "dev": "node --watch src/index.js",
    "dev:http": "node --watch src/server-http.js",
    "test": "node src/test.js",
    "test:memory": "node --test src/tools-memory/*.test.js",
    "gen-memory-token": "node -e \"console.log(require('crypto').randomBytes(36).toString('hex'))\"",
    "generate-tool-catalog": "node scripts/generate-tool-catalog.mjs",
    "test:security": "node --test src/tests/phase0-security.test.js",
    "test:brain-scan": "node --test src/tests/brain-scan-manual-only.test.js",
    "test:render-tools": "node --test src/tests/render-tools.test.js",
    "test:edit-tools": "node --test src/tests/edit-tools.test.js",
    "test:validation-tools": "node --test src/tests/validation-tools.test.js",
    "test:gateway-tools": "node --test src/tests/render-tools.test.js src/tests/edit-tools.test.js src/tests/validation-tools.test.js",
    "test:voice": "node --test src/tests/voice.test.js",
    "voice:benchmark": "node scripts/voice-benchmark.mjs",
    "voice:provision": "node scripts/voice-provision.mjs",
    "test:prosody": "node --test src/tests/voice-prosody.test.js",
    "test:normalize": "node --test src/tests/voice-text-normalize.test.js",
    "test:prosody-prep": "node --test src/tests/voice-prosody-prep.test.js",
    "test:registry": "node --test src/tests/voice-registry.test.js src/tests/voice-stream-split.test.js",
    "test:stream-split": "node --test src/tests/voice-stream-split.test.js",
    "test:homework-normalise": "node --test src/tests/homework-normalise.test.js",
    "test:homework": "node --test src/tests/homework-normalise.test.js src/tests/homework-extract.test.js src/tests/homework-route.test.js src/tests/homework-roundtrip.test.js src/tests/homework-real-worksheet.test.js",
    "test:incremental": "node --experimental-test-module-mocks --test src/tests/voice-incremental.test.js",
    "test:gpl-boundary": "node --test src/tests/voice-gpl-boundary.test.js",
    "test:voice-all": "node --test src/tests/voice.test.js src/tests/voice-auth.test.js src/tests/voice-prosody.test.js src/tests/voice-gpl-boundary.test.js src/tests/voice-stt-worker.test.js src/tests/voice-text-normalize.test.js src/tests/voice-prosody-prep.test.js src/tests/voice-registry.test.js src/tests/voice-stream-split.test.js",
    "voice:smoke": "node scripts/voice-worker-smoke.mjs",
    "test:stt-worker": "node --test src/tests/voice-stt-worker.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^11.3.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.3.0",
    "jstat": "^1.9.6",
    "luxon": "^3.7.2",
    "ml-kmeans": "^6.0.0",
    "ml-matrix": "^6.12.0",
    "ml-pca": "^4.1.1",
    "ml-regression-multivariate-linear": "^2.0.4",
    "ml-regression-polynomial": "^3.0.0",
    "ml-regression-simple-linear": "^2.0.4",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "simple-statistics": "^7.8.7",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "mcp",
    "claude",
    "anthropic",
    "memory",
    "persistent-memory",
    "sqlite",
    "linkedin",
    "web-search",
    "news",
    "ai-agent",
    "smtp",
    "email",
    "tracking",
    "scheduler",
    "google-drive",
    "google-calendar",
    "google-sheets",
    "slack",
    "teams",
    "webhook",
    "wordpress",
    "statistics",
    "machine-learning",
    "data-analysis",
    "regression",
    "time-series",
    "clustering",
    "pca"
  ],
  "license": "MIT"
}
